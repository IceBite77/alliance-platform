{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alliance-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_URL": "https://app.allianceplatform.games",
    "DISCORD_CLIENT_ID": "1548705012215976026"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alliance-platform",
      "database_id": "737bf7e0-71d8-403a-a002-bcbd84bb4714",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "alliance-platform-assets"
    }
  ],
  "observability": {
    "enabled": true
  }
}
